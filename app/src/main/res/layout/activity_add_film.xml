<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_actor_list_screen"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="132dp"
            android:background="@drawable/bg_actor_list_header"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="18dp"
            android:paddingEnd="18dp">

            <ImageView
                android:id="@+id/btnBackToFilmListFromAddFilm"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_actor_toolbar_button"
                android:contentDescription="Quay lại"
                android:padding="10dp"
                android:src="@drawable/ic_back"
                app:tint="@color/white" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Thêm phim mới" android:textColor="@color/white" android:textSize="24sp" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Nhập thông tin phim" android:textColor="#FDE7E4" android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="18dp"
            android:layout_marginTop="-28dp"
            android:layout_marginEnd="18dp"
            android:layout_marginBottom="24dp"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="8dp"
            app:cardElevation="6dp"
            app:strokeColor="#F1D6D2"
            app:strokeWidth="1dp">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Tên phim" android:textColor="@color/app_text" android:textStyle="bold" />
                <EditText android:id="@+id/edtTitle" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="8dp" android:background="@drawable/bg_actor_form_input" android:hint="Tiêu đề phim" android:maxLines="1" android:paddingStart="14dp" android:paddingEnd="14dp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="Năm phát hành" android:textColor="@color/app_text" android:textStyle="bold" />
                <EditText android:id="@+id/edtReleaseYear" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="8dp" android:background="@drawable/bg_actor_form_input" android:hint="Năm phát hành" android:inputType="number" android:maxLines="1" android:paddingStart="14dp" android:paddingEnd="14dp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="Đạo diễn" android:textColor="@color/app_text" android:textStyle="bold" />
                <EditText android:id="@+id/edtDirector" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="8dp" android:background="@drawable/bg_actor_form_input" android:hint="Đạo diễn" android:maxLines="1" android:paddingStart="14dp" android:paddingEnd="14dp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="Tóm tắt nội dung" android:textColor="@color/app_text" android:textStyle="bold" />
                <EditText android:id="@+id/edtSynopsis" android:layout_width="match_parent" android:layout_height="96dp" android:layout_marginTop="8dp" android:background="@drawable/bg_actor_form_input" android:gravity="top|start" android:hint="Tóm tắt nội dung" android:inputType="textMultiLine" android:padding="14dp" android:scrollHorizontally="false" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="Ảnh minh họa" android:textColor="@color/app_text" android:textStyle="bold" />
                <FrameLayout android:layout_width="match_parent" android:layout_height="250dp" android:layout_marginTop="10dp" android:background="@drawable/bg_actor_image_picker" android:padding="14dp">
                    <ImageView android:id="@+id/imgPoster" android:layout_width="150dp" android:layout_height="200dp" android:layout_gravity="center" android:background="@drawable/bg_app_poster" android:padding="6dp" android:scaleType="centerCrop" android:src="@drawable/ic_poster" />
                    <TextView android:layout_width="wrap_content" android:layout_height="32dp" android:layout_gravity="bottom|center_horizontal" android:background="@drawable/bg_actor_image_picker_badge" android:gravity="center" android:paddingStart="14dp" android:paddingEnd="14dp" android:text="Chạm để chọn ảnh" android:textColor="#7A5151" android:textSize="13sp" android:textStyle="bold" />
                </FrameLayout>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="Trailer" android:textColor="@color/app_text" android:textStyle="bold" />
                <EditText android:id="@+id/edtTrailerURL" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="8dp" android:background="@drawable/bg_actor_form_input" android:hint="URL Trailer" android:inputType="textUri" android:maxLines="1" android:paddingStart="14dp" android:paddingEnd="14dp" />
                <Button android:id="@+id/btnAddFilm" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="22dp" android:background="@drawable/bg_actor_primary_button" android:text="Thêm phim" android:textAllCaps="false" android:textColor="@color/white" android:textSize="16sp" android:textStyle="bold" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>
