<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_actor_list_screen">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="96dp"
            android:background="@drawable/bg_actor_list_header"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="18dp"
            android:paddingEnd="18dp">

            <ImageView
                android:id="@+id/btnBackToHomeFromFilmProfile"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_actor_toolbar_button"
                android:contentDescription="Quay lại"
                android:padding="10dp"
                android:src="@drawable/ic_back"
                app:tint="@color/white" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:text="Chi tiết phim"
                android:textColor="@color/white"
                android:textSize="24sp"
                android:textStyle="bold" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="18dp"
            android:layout_marginTop="-18dp"
            android:layout_marginEnd="18dp"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="8dp"
            app:cardElevation="6dp"
            app:strokeColor="#F1D6D2"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <ImageView
                    android:id="@+id/imagePoster"
                    android:layout_width="190dp"
                    android:layout_height="270dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_app_poster"
                    android:padding="4dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_poster" />

                <Button
                    android:id="@+id/buttonWatchTrailer"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_actor_primary_button"
                    android:text="Xem Trailer"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/textTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="Tên Phim"
                    android:textColor="@color/app_text"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/textReleaseYear"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Năm phát hành"
                    android:textColor="@color/app_text_muted"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/textDirector"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Đạo diễn"
                    android:textColor="@color/app_text_muted"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/textGenre"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Thể loại"
                    android:textColor="@color/app_text_muted"
                    android:textSize="14sp" />

                <LinearLayout
                    android:id="@+id/ratingsSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_app_info_field"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Đánh giá chi tiết"
                        android:textColor="@color/app_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center_vertical" android:orientation="horizontal">
                        <TextView android:id="@+id/textContentRating" android:layout_width="92dp" android:layout_height="wrap_content" android:text="Nội dung" android:textColor="@color/app_text_muted" android:textSize="14sp" />
                        <RatingBar android:id="@+id/ratingBarContent" style="?android:attr/ratingBarStyleSmall" android:layout_width="wrap_content" android:layout_height="wrap_content" android:isIndicator="true" android:numStars="5" android:progressTint="@color/gold" android:rating="0" android:stepSize="0.1" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                        <TextView android:id="@+id/textEffectRating" android:layout_width="92dp" android:layout_height="wrap_content" android:text="Hiệu ứng" android:textColor="@color/app_text_muted" android:textSize="14sp" />
                        <RatingBar android:id="@+id/ratingBarEffect" style="?android:attr/ratingBarStyleSmall" android:layout_width="wrap_content" android:layout_height="wrap_content" android:isIndicator="true" android:numStars="5" android:progressTint="@color/gold" android:rating="0" android:stepSize="0.1" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                        <TextView android:id="@+id/textCastRating" android:layout_width="92dp" android:layout_height="wrap_content" android:text="Diễn xuất" android:textColor="@color/app_text_muted" android:textSize="14sp" />
                        <RatingBar android:id="@+id/ratingBarCast" style="?android:attr/ratingBarStyleSmall" android:layout_width="wrap_content" android:layout_height="wrap_content" android:isIndicator="true" android:numStars="5" android:progressTint="@color/gold" android:rating="0" android:stepSize="0.1" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                        <TextView android:id="@+id/textOverallRating" android:layout_width="92dp" android:layout_height="wrap_content" android:text="Tổng thể" android:textColor="@color/app_text_muted" android:textSize="14sp" />
                        <RatingBar android:id="@+id/ratingBarOverall" style="?android:attr/ratingBarStyleSmall" android:layout_width="wrap_content" android:layout_height="wrap_content" android:isIndicator="true" android:numStars="5" android:progressTint="@color/gold" android:rating="0" android:stepSize="0.1" />
                    </LinearLayout>
                    <TextView android:id="@+id/textReviewCount" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Số lượt đánh giá: 0" android:textColor="@color/app_text_muted" android:textSize="14sp" />
                </LinearLayout>

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="Diễn viên" android:textColor="@color/app_text" android:textSize="16sp" android:textStyle="bold" />
                <androidx.recyclerview.widget.RecyclerView android:id="@+id/recyclerActors" android:layout_width="match_parent" android:layout_height="120dp" android:layout_marginTop="8dp" android:clipToPadding="false" android:orientation="horizontal" android:overScrollMode="never" />

                <TextView
                    android:id="@+id/textSynopsis"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:lineSpacingExtra="3dp"
                    android:text="Nội dung phim..."
                    android:textColor="@color/app_text"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/buttonRate"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_actor_primary_button"
                    android:text="Đánh giá"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textStyle="bold" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:id="@+id/commentContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="18dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="18dp"
            android:layout_marginBottom="24dp"
            android:background="@drawable/bg_app_menu_card"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Bình luận" android:textColor="@color/app_text" android:textSize="18sp" android:textStyle="bold" />
                <TextView android:id="@+id/txtSortDate" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Cũ nhất" android:textColor="@color/app_text_muted" android:textStyle="bold" />
                <ImageView android:id="@+id/btnSortDate" android:layout_width="32dp" android:layout_height="32dp" android:layout_marginStart="6dp" android:padding="7dp" android:src="@drawable/ic_sortdate" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerComments"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="8dp" />

            <Button
                android:id="@+id/btnLoadMore"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_app_menu_card"
                android:text="Tải thêm bình luận"
                android:textAllCaps="false"
                android:textColor="@color/app_primary"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
