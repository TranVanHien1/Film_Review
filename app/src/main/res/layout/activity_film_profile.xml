<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:orientation="horizontal"
            >
            <ImageView
                android:id="@+id/btnBackToHomeFromFilmProfile"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/ic_back"
                android:layout_gravity="center"
                android:layout_marginLeft="10dp">
            </ImageView>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:orientation="vertical">
            <!-- Poster -->
            <ImageView
                android:id="@+id/imagePoster"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:scaleType="center"
                android:src="@drawable/ic_poster"
                android:background="#000000" />

            <Button
                android:id="@+id/buttonWatchTrailer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Xem Trailer"
                android:backgroundTint="#FF3D00"
                android:layout_gravity="center"
                android:textColor="#FFFFFF"
                android:layout_marginTop="5dp" />

            <!-- Title -->
            <TextView
                android:id="@+id/textTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tên Phim"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_marginTop="12dp" />

            <!-- Release Year + Director -->
            <TextView
                android:id="@+id/textReleaseYear"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="2025"
                android:textColor="#CCCCCC"
                android:textSize="14sp"
                android:layout_marginTop="4dp" />
            <TextView
                android:id="@+id/textDirector"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Đạo diễn: David F. Sandberg"
                android:textColor="#CCCCCC"
                android:textSize="14sp"
                android:layout_marginTop="4dp" />

            <!-- Genre -->
            <TextView
                android:id="@+id/textGenre"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Thể loại: Kinh dị, Hồi hộp"
                android:textColor="#CCCCCC"
                android:textSize="14sp"
                android:layout_marginTop="4dp" />

            <!-- Rating -->
            <!-- Detailed Ratings -->
            <LinearLayout
                android:id="@+id/ratingsSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Đánh giá chi tiết:"
                    android:textColor="#FF9800"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:layout_marginBottom="4dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView
                        android:id="@+id/textContentRating"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Nội dung: "
                        android:textColor="#CCCCCC"
                        android:textSize="14sp"/>
                    <RatingBar
                        android:id="@+id/ratingBarContent"
                        style="?android:attr/ratingBarStyleSmall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:numStars="5"
                        android:stepSize="0.1"
                        android:rating="0"
                        android:isIndicator="true"
                        android:progressTint="@color/gold"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView
                        android:id="@+id/textEffectRating"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Hiệu ứng: "
                        android:textColor="#CCCCCC"
                        android:textSize="14sp"/>
                    <RatingBar
                        android:id="@+id/ratingBarEffect"
                        style="?android:attr/ratingBarStyleSmall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:numStars="5"
                        android:stepSize="0.1"
                        android:rating="0"
                        android:isIndicator="true"
                        android:progressTint="@color/gold"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView
                        android:id="@+id/textCastRating"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Diễn xuất: "
                        android:textColor="#CCCCCC"
                        android:textSize="14sp"/>
                    <RatingBar
                        android:id="@+id/ratingBarCast"
                        style="?android:attr/ratingBarStyleSmall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:numStars="5"
                        android:stepSize="0.1"
                        android:rating="0"
                        android:isIndicator="true"
                        android:progressTint="@color/gold"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView
                        android:id="@+id/textOverallRating"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tổng thể: "
                        android:textColor="#CCCCCC"
                        android:textSize="14sp"/>
                    <RatingBar
                        android:id="@+id/ratingBarOverall"
                        style="?android:attr/ratingBarStyleSmall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:numStars="5"
                        android:stepSize="0.1"
                        android:rating="0"
                        android:isIndicator="true"
                        android:progressTint="@color/gold"/>
                </LinearLayout>

                <TextView
                    android:id="@+id/textReviewCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Số lượt đánh giá: 0"
                    android:textColor="#CCCCCC"
                    android:textSize="14sp"/>
            </LinearLayout>

            <!-- Actor -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Diễn viên"
                android:textColor="#FF9800"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginTop="16dp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerActors"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:overScrollMode="never"/>


            <!-- Synopsis -->
            <TextView
                android:id="@+id/textSynopsis"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Nội dung phim: ..."
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:layout_marginTop="12dp" />

            <!-- Trailer Button -->


            <Button
                android:id="@+id/buttonRate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Đánh giá"
                android:backgroundTint="#FF3D00"
                android:layout_gravity="center"
                android:textColor="#FFFFFF"
                android:layout_marginTop="5dp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/commentContainer"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:background="#FFFFFF">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="Bình luận"
                    >
                </TextView>

                <TextView
                    android:id="@+id/txtSortDate"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="Cũ nhất"
                    >
                </TextView>
                <ImageView
                    android:id="@+id/btnSortDate"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_sortdate"
                    android:layout_gravity="center">
                </ImageView>

            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerComments"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"/>

            <Button
                android:id="@+id/btnLoadMore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tải thêm bình luận"
                android:layout_gravity="center"/>
        </LinearLayout>




    </LinearLayout>
</ScrollView>
