<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_actor_list_screen">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="132dp" android:background="@drawable/bg_actor_list_header" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="18dp" android:paddingEnd="18dp">
            <ImageView android:id="@+id/btnBackToFilmDetailFromFilmEdit" android:layout_width="42dp" android:layout_height="42dp" android:background="@drawable/bg_actor_toolbar_button" android:contentDescription="Quay lại" android:padding="10dp" android:src="@drawable/ic_back" app:tint="@color/white" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Cập nhật phim" android:textColor="@color/white" android:textSize="24sp" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Chỉnh sửa thông tin phim" android:textColor="#FDE7E4" android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="18dp" android:layout_marginTop="-28dp" android:layout_marginEnd="18dp" android:layout_marginBottom="24dp" app:cardBackgroundColor="@color/white" app:cardCornerRadius="8dp" app:cardElevation="6dp" app:strokeColor="#F1D6D2" app:strokeWidth="1dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Poster" android:textColor="@color/app_text" android:textStyle="bold" />
                <ImageView android:id="@+id/imgAvatarFilmEdit" android:layout_width="150dp" android:layout_height="200dp" android:layout_gravity="center" android:layout_marginTop="10dp" android:background="@drawable/bg_app_poster" android:padding="4dp" android:scaleType="centerCrop" android:src="@drawable/ic_poster" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="Tên phim" android:textColor="@color/app_text" android:textStyle="bold" />
                <EditText android:id="@+id/edtTitle" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="8dp" android:background="@drawable/bg_actor_form_input" android:hint="Title" android:maxLines="1" android:paddingStart="14dp" android:paddingEnd="14dp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="Năm sản xuất" android:textColor="@color/app_text" android:textStyle="bold" />
                <EditText android:id="@+id/edtYear" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="8dp" android:background="@drawable/bg_actor_form_input" android:hint="Release Year" android:maxLines="1" android:paddingStart="14dp" android:paddingEnd="14dp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="Đạo diễn" android:textColor="@color/app_text" android:textStyle="bold" />
                <EditText android:id="@+id/edtDirector" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="8dp" android:background="@drawable/bg_actor_form_input" android:hint="Director" android:maxLines="1" android:paddingStart="14dp" android:paddingEnd="14dp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="Nội dung chính" android:textColor="@color/app_text" android:textStyle="bold" />
                <EditText android:id="@+id/edtSynopsis" android:layout_width="match_parent" android:layout_height="96dp" android:layout_marginTop="8dp" android:background="@drawable/bg_actor_form_input" android:gravity="top|start" android:hint="Synopsis" android:inputType="textMultiLine" android:padding="14dp" android:scrollHorizontally="false" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="Trailer" android:textColor="@color/app_text" android:textStyle="bold" />
                <EditText android:id="@+id/edtTrailerUrl" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="8dp" android:background="@drawable/bg_actor_form_input" android:hint="Trailer URL" android:inputType="textUri" android:maxLines="1" android:paddingStart="14dp" android:paddingEnd="14dp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="Thể loại" android:textColor="@color/app_text" android:textStyle="bold" />
                <Button android:id="@+id/btnSelectGenres" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="8dp" android:background="@drawable/bg_app_menu_card" android:text="Chọn thể loại" android:textAllCaps="false" android:textColor="@color/app_primary" android:textStyle="bold" />
                <TextView android:id="@+id/txtSelectedGenres" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="@drawable/bg_app_info_field" android:minHeight="48dp" android:textColor="@color/app_text" android:textSize="15sp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="Diễn viên" android:textColor="@color/app_text" android:textStyle="bold" />
                <Button android:id="@+id/btnSelectActors" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="8dp" android:background="@drawable/bg_app_menu_card" android:text="Chọn diễn viên" android:textAllCaps="false" android:textColor="@color/app_primary" android:textStyle="bold" />
                <TextView android:id="@+id/txtSelectedActors" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="@drawable/bg_app_info_field" android:minHeight="48dp" android:textColor="@color/app_text" android:textSize="15sp" />
                <Button android:id="@+id/btnSave" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="22dp" android:background="@drawable/bg_actor_primary_button" android:text="Lưu" android:textAllCaps="false" android:textColor="@color/white" android:textSize="16sp" android:textStyle="bold" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>
