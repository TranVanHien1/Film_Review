<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/white"
    android:orientation="vertical"
    android:padding="22dp">

    <TextView
        android:id="@+id/tvForgotPasswordTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="Quên mật khẩu"
        android:textColor="@color/app_text"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:text="Nhập email đã đăng ký để nhận hướng dẫn"
        android:textColor="@color/app_text_muted"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/edForgotEmail"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="18dp"
        android:background="@drawable/bg_actor_form_input"
        android:hint="Email đã đăng ký"
        android:inputType="textEmailAddress"
        android:maxLines="1"
        android:paddingStart="14dp"
        android:paddingEnd="14dp" />
</LinearLayout>
