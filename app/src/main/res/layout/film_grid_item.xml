<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="120dp"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    android:gravity="top"
    android:orientation="vertical">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardFilmPoster"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        app:cardCornerRadius="8dp"
        app:cardElevation="3dp"
        app:strokeColor="#F0DEDA"
        app:strokeWidth="1dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageView
                android:id="@+id/imgFilmPoster"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_poster" />

            <TextView
                android:id="@+id/txtFilmYear"
                android:layout_width="wrap_content"
                android:layout_height="26dp"
                android:layout_gravity="top|end"
                android:layout_margin="8dp"
                android:background="@drawable/bg_actor_image_picker_badge"
                android:gravity="center"
                android:minWidth="48dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:textColor="@color/app_primary"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="2026" />

            <TextView
                android:id="@+id/txtFilmRating"
                android:layout_width="wrap_content"
                android:layout_height="26dp"
                android:layout_gravity="bottom|start"
                android:layout_margin="8dp"
                android:background="@drawable/bg_actor_image_picker_badge"
                android:gravity="center"
                android:minWidth="48dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:textColor="@color/app_primary"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="★ 4.5" />
        </FrameLayout>
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/txtFilmTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="2"
        android:textColor="@color/app_text"
        android:textSize="14sp"
        android:textStyle="bold"
        tools:text="Tên phim" />

    <TextView
        android:id="@+id/txtFilmDirector"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:textColor="@color/app_text_muted"
        android:textSize="12sp"
        tools:text="Đạo diễn" />
</LinearLayout>
