<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_actor_list_screen"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="132dp"
            android:background="@drawable/bg_actor_list_header"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="18dp"
            android:paddingEnd="18dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Quản trị viên"
                    android:textColor="@color/white"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Bảng điều khiển hệ thống"
                    android:textColor="#FDE7E4"
                    android:textSize="14sp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/btnlogout"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@drawable/bg_actor_toolbar_button"
                android:contentDescription="Đăng xuất"
                android:padding="10dp"
                android:src="@drawable/ic_logout"
                app:tint="@color/white" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="-18dp"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingBottom="18dp">

            <LinearLayout
                android:id="@+id/layout1"
                android:layout_width="match_parent"
                android:layout_height="78dp"
                android:background="@drawable/bg_app_menu_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="18dp"
                android:paddingEnd="14dp">

                <TextView
                    android:id="@+id/txtDanhsachUser"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Người dùng"
                    android:textColor="@color/app_text"
                    android:textSize="19sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/btnDanhSachUser"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:contentDescription="Mở danh sách người dùng"
                    android:padding="7dp"
                    android:src="@drawable/arrow"
                    app:tint="@color/app_primary" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="78dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_app_menu_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="18dp"
                android:paddingEnd="14dp">

                <TextView
                    android:id="@+id/txtDanhsachPhim"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Phim"
                    android:textColor="@color/app_text"
                    android:textSize="19sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/btnDanhSachPhim"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:contentDescription="Mở danh sách phim"
                    android:padding="7dp"
                    android:src="@drawable/arrow"
                    app:tint="@color/app_primary" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="78dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_app_menu_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="18dp"
                android:paddingEnd="14dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Diễn viên"
                    android:textColor="@color/app_text"
                    android:textSize="19sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/btnDanhSachDienVien"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:contentDescription="Mở danh sách diễn viên"
                    android:padding="7dp"
                    android:src="@drawable/arrow"
                    app:tint="@color/app_primary" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="78dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_app_menu_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="18dp"
                android:paddingEnd="14dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Thể loại"
                    android:textColor="@color/app_text"
                    android:textSize="19sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/btnDanhSachTheLoai"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:contentDescription="Mở danh sách thể loại"
                    android:padding="7dp"
                    android:src="@drawable/arrow"
                    app:tint="@color/app_primary" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="78dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_app_menu_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="18dp"
                android:paddingEnd="14dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Thông báo"
                    android:textColor="@color/app_text"
                    android:textSize="19sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/btnDanhSachThongbao"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:contentDescription="Mở danh sách thông báo"
                    android:padding="7dp"
                    android:src="@drawable/arrow"
                    app:tint="@color/app_primary" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
