<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/white"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tên diễn viên"
        android:textColor="@color/app_text"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/edtActorName"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_actor_form_input"
        android:hint="Tên diễn viên"
        android:maxLines="1"
        android:paddingStart="14dp"
        android:paddingEnd="14dp" />

    <ImageView
        android:id="@+id/imgActor"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_gravity="center"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_actor_avatar"
        android:padding="4dp"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_user" />

    <Button
        android:id="@+id/btnChooseImage"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_app_menu_card"
        android:text="Chọn ảnh"
        android:textAllCaps="false"
        android:textColor="@color/app_primary"
        android:textStyle="bold" />
</LinearLayout>
