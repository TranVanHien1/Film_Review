<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/white"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Thông tin đánh giá"
        android:textColor="@color/app_text"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/txtCastRating"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_app_info_field"
        android:text="Cast Rating: "
        android:textColor="@color/app_text" />

    <TextView
        android:id="@+id/txtContentRating"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_app_info_field"
        android:text="Content Rating: "
        android:textColor="@color/app_text" />

    <TextView
        android:id="@+id/txtEffectRating"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_app_info_field"
        android:text="Effect Rating: "
        android:textColor="@color/app_text" />

    <TextView
        android:id="@+id/txtRating"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_app_info_field"
        android:text="Average Rating: "
        android:textColor="@color/app_text" />

    <TextView
        android:id="@+id/txtReviewCount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_app_info_field"
        android:text="Số lượt đánh giá: "
        android:textColor="@color/app_text" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Điểm ưu tiên"
        android:textColor="@color/app_text"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/edtRatePoint"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_actor_form_input"
        android:hint="Nhập ratePoint mới"
        android:inputType="numberDecimal"
        android:maxLines="1"
        android:paddingStart="14dp"
        android:paddingEnd="14dp" />
</LinearLayout>
